---
import DetailLayout from '../../layouts/DetailLayout.astro';
import ClickableImage from '../../components/ClickableImage.svelte';
import Icon from '../../components/Icon.svelte';
import ActionButton from '../../components/ActionButton.astro';
import { render } from 'astro:content';
import { published } from '../../utils/content';
import { ROUTES } from '../../utils/routes';
import { getProjectMedia } from '../../utils/projectImages';

export async function getStaticPaths() {
  const projects = await published('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const { thumbnail: thumbnailSrc, gallery: galleryImages } = getProjectMedia(project.id);

const hasImage = !!thumbnailSrc;
const tags = project.data.tags || [];
const teamLabel = project.data.teamSize === 1 ? 'person' : 'people';
---

<DetailLayout
  title={`${project.data.title} — Bartłomiej Gordon`}
  description={project.data.description}
  image={thumbnailSrc}
  backHref={ROUTES.projects}
  backLabel="Back to Projects"
  containerWidth="narrow"
  galleryItems={galleryImages}
  galleryTitle={project.data.title}
>
  <header class="project-header" slot="header">
    {hasImage && (
      <div class="project-image">
        <ClickableImage
          src={thumbnailSrc}
          alt={project.data.title}
          client:load
        />
      </div>
    )}

    <div class="project-info">
      <div class="meta">
        <span class="date">{project.data.date}</span>
        {project.data.teamSize && (
          <span class="team-badge">
            <Icon name="team" size={14} />
            <span>{project.data.teamSize} {teamLabel}</span>
          </span>
        )}
      </div>

      <h1>{project.data.title}</h1>
      <p class="description">{project.data.description}</p>

      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}

      <div class="actions">
        {project.data.playUrl && (
          <ActionButton href={project.data.playUrl} label="Play Game" icon="play" primary external />
        )}
        {project.data.sourceUrl && (
          <ActionButton href={project.data.sourceUrl} label="Source Code" icon="github" external />
        )}
      </div>
    </div>
  </header>

  <Content />
</DetailLayout>

<style>
  .project-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-11);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .project-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
    display: flex;
    align-items: center;
  }

  .project-image :global(.clickable-image) {
    width: 100%;
  }

  .project-image :global(.clickable-image img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .project-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    margin-bottom: var(--space-5);
    color: var(--color-text-primary);
  }

  .description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-7);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  @media (max-width: 768px) {
    .project-header {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    h1 {
      font-size: var(--font-size-2xl);
    }
  }
</style>
