---
import DetailLayout from '../../layouts/DetailLayout.astro';
import ClickableImage from '../../components/ClickableImage.svelte';
import { render } from 'astro:content';
import ActionButton from '../../components/ActionButton.astro';
import { ROUTES } from '../../utils/routes';
import { published, assertProjectRefs } from '../../utils/content';

export async function getStaticPaths() {
  const [achievements, projects] = await Promise.all([
    published('achievements'),
    published('projects'),
  ]);

  assertProjectRefs(achievements, projects);

  return achievements.map((achievement) => ({
    params: { slug: achievement.id },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);

const hasImage = !!achievement.data.image;
---

<DetailLayout
  title={`${achievement.data.title} — Bartłomiej Gordon`}
  description={achievement.data.description}
  image={achievement.data.image}
  backHref={ROUTES.achievements}
  backLabel="Back to Achievements"
  containerWidth="article"
  galleryItems={achievement.data.gallery}
  galleryTitle={achievement.data.title}
>
  <header class="achievement-header" slot="header">
    <p class="meta">
      <span class="meta-type">{achievement.data.type}</span> · {achievement.data.date}
    </p>

    <h1>{achievement.data.title}</h1>
    <p class="event">{achievement.data.event}</p>
    <p class="description">{achievement.data.description}</p>

    <div class="actions">
      {achievement.data.url && (
        <ActionButton href={achievement.data.url} label="Open Link" icon="external" primary external />
      )}
      {achievement.data.project && (
        <ActionButton href={`/projects/${achievement.data.project}`} label="View Project" icon="gamepad" />
      )}
    </div>

    {hasImage && (
      <div class="featured-image">
        <ClickableImage src={achievement.data.image} alt={achievement.data.title} client:load />
      </div>
    )}
  </header>

  <Content />
</DetailLayout>

<style>
  .achievement-header {
    margin-bottom: var(--space-11);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .meta-type {
    text-transform: capitalize;
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-page-title);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .event {
    font-size: var(--font-size-md);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-6);
  }

  .description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
    max-width: 60ch;
  }

  .actions {
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .featured-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
  }

  .featured-image :global(.clickable-image) { width: 100%; }
  .featured-image :global(.clickable-image img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
