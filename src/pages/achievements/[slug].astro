---
import DetailLayout from '../../layouts/DetailLayout.astro';
import ClickableImage from '../../components/ClickableImage.svelte';
import { getCollection, render } from 'astro:content';
import Icon from '../../components/Icon.svelte';
import { collectLightboxImages } from '../../utils/media';
import { ROUTES } from '../../utils/routes';

export async function getStaticPaths() {
  const [achievements, games] = await Promise.all([
    getCollection('achievements', ({ data }) => !data.draft),
    getCollection('games', ({ data }) => !data.draft),
  ]);

  const gameIds = new Set(games.map((g) => g.id));

  for (const achievement of achievements) {
    if (achievement.data.game && !gameIds.has(achievement.data.game)) {
      throw new Error(
        `Achievement "${achievement.id}" references unknown game "${achievement.data.game}". Valid IDs: ${[...gameIds].sort().join(', ')}`
      );
    }
  }

  return achievements.map((achievement) => ({
    params: { slug: achievement.id },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);

const isWinner = achievement.data.type === 'winner';
const hasImage = !!achievement.data.image;
const iconName = achievement.data.icon;

const allImages = collectLightboxImages(achievement.data.image, achievement.data.gallery);
---

<DetailLayout
  title={`${achievement.data.title} — Bartłomiej Gordon`}
  description={achievement.data.description}
  image={achievement.data.image}
  backHref={ROUTES.achievements}
  backLabel="Back to Achievements"
  containerWidth="article"
  galleryItems={achievement.data.gallery}
  galleryTitle={achievement.data.title}
>
  <header class="achievement-header" slot="header">
    <div class="header-content">
      <div class="icon-wrapper" class:list={{ winner: isWinner }}>
        <Icon name={iconName} size={32} strokeWidth={1.5} />
      </div>

      <div class="header-info">
        <div class="meta">
          <span class="tag" class:list={{ 'tag--highlight': isWinner }}>
            {isWinner ? 'Winner' : achievement.data.type}
          </span>
          <span class="date">{achievement.data.date}</span>
          {achievement.data.participants && (
            <span class="participants">{achievement.data.participants} participants</span>
          )}
        </div>

        <h1>{achievement.data.title}</h1>
        <p class="event">{achievement.data.event}</p>
        <p class="description">{achievement.data.description}</p>

        {achievement.data.rank && (
          <div class="rank-badge">
            <span class="rank-value">{achievement.data.rank}</span>
          </div>
        )}

        <div class="actions">
          {achievement.data.url && (
            <a
              href={achievement.data.url}
              class="btn btn--primary"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="external" size={16} />
              Open Link
            </a>
          )}
          {achievement.data.game && (
            <a href={`/games/${achievement.data.game}`} class="btn">
              <Icon name="gamepad" size={16} />
              View Game
            </a>
          )}
        </div>
      </div>
    </div>

    {hasImage && (
      <div class="featured-image">
        <ClickableImage
          src={achievement.data.image}
          alt={achievement.data.title}
          allImages={allImages}
          client:load
        />
      </div>
    )}
  </header>

  <Content />
</DetailLayout>

<style>
  .achievement-header {
    margin-bottom: var(--space-11);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .header-content {
    display: flex;
    gap: var(--space-9);
    margin-bottom: var(--space-9);
  }

  .icon-wrapper {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-elevated);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
  }

  .icon-wrapper.winner {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }

  .header-info {
    flex: 1;
  }

  .participants {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border-light);
  }

  h1 {
    font-family: var(--font-display);
    font-size: 2.25rem;
    margin-bottom: var(--space-3);
    color: var(--color-text-primary);
  }

  .event {
    font-size: 1.1rem;
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-5);
  }

  .description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-7);
  }

  .rank-badge {
    display: inline-flex;
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-8);
  }

  .rank-value {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .actions {
    display: flex;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .featured-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
  }

  .featured-image :global(.clickable-image) {
    width: 100%;
  }

  .featured-image :global(.clickable-image img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      gap: var(--space-8);
    }

    .icon-wrapper {
      width: 56px;
      height: 56px;
    }

    h1 {
      font-size: 1.75rem;
    }

    .actions {
      flex-direction: column;
    }
  }
</style>
