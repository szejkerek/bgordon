---
import DetailLayout from '../../layouts/DetailLayout.astro';
import { render } from 'astro:content';
import ActionButton from '../../components/ActionButton.astro';
import { ROUTES } from '../../utils/routes';
import { publishedAchievements } from '../../utils/content';
import { formatDate } from '../../utils/dates';

export async function getStaticPaths() {
  const achievements = await publishedAchievements();

  return achievements.map((achievement) => ({
    params: { slug: achievement.id },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);
---

<DetailLayout
  title={`${achievement.data.title} — Bartłomiej Gordon`}
  description={achievement.data.description}
  image={achievement.data.gallery?.[0]}
  backHref={ROUTES.achievements}
  backLabel="Back to Achievements"
  containerWidth="article"
  galleryItems={achievement.data.gallery}
  galleryTitle={achievement.data.title}
>
  <header class="achievement-header" slot="header">
    <div class="meta">
      <span class="type">{achievement.data.type}</span>
      <span class="dot" aria-hidden="true"></span>
      <span class="date">{formatDate(achievement.data.date)}</span>
      {achievement.data.rank && (
        <>
          <span class="dot" aria-hidden="true"></span>
          <span class="rank">{achievement.data.rank}</span>
        </>
      )}
      {achievement.data.participants && (
        <>
          <span class="dot" aria-hidden="true"></span>
          <span>{achievement.data.participants} participants</span>
        </>
      )}
    </div>

    <h1>{achievement.data.title}</h1>
    <p class="event">{achievement.data.event}</p>
    <p class="description">{achievement.data.description}</p>

    {(achievement.data.url || achievement.data.project) && (
      <div class="actions">
        {achievement.data.url && (
          <ActionButton href={achievement.data.url} label="Open Link" icon="external" primary external />
        )}
        {achievement.data.project && (
          <ActionButton href={`/projects/${achievement.data.project.id}`} label="View Project" icon="play" />
        )}
      </div>
    )}
  </header>

  <Content />
</DetailLayout>

<style>
  .achievement-header {
    margin-bottom: var(--space-9);
    padding-bottom: var(--space-9);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .meta .type {
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
  }

  .meta .dot {
    width: 3px;
    height: 3px;
    border-radius: var(--radius-full);
    background: var(--color-text-muted);
  }

  .meta .rank {
    color: var(--color-text-secondary);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-page-title);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .event {
    font-size: var(--font-size-md);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-6);
  }

  .description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-8);
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
</style>
