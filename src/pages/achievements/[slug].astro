---
import DetailLayout from '../../layouts/DetailLayout.astro';
import ClickableImage from '../../components/ClickableImage.svelte';
import { getCollection, render } from 'astro:content';
import Icon from '../../components/Icon.svelte';
import { ROUTES } from '../../utils/routes';

export async function getStaticPaths() {
  const [achievements, games] = await Promise.all([
    getCollection('achievements', ({ data }) => !data.draft),
    getCollection('games', ({ data }) => !data.draft),
  ]);

  const gameIds = new Set(games.map((g) => g.id));

  for (const achievement of achievements) {
    if (achievement.data.game && !gameIds.has(achievement.data.game)) {
      throw new Error(
        `Achievement "${achievement.id}" references unknown game "${achievement.data.game}". Valid IDs: ${[...gameIds].sort().join(', ')}`
      );
    }
  }

  return achievements.map((achievement) => ({
    params: { slug: achievement.id },
    props: { achievement },
  }));
}

const { achievement } = Astro.props;
const { Content } = await render(achievement);

const hasImage = !!achievement.data.image;
---

<DetailLayout
  title={`${achievement.data.title} — Bartłomiej Gordon`}
  description={achievement.data.description}
  image={achievement.data.image}
  backHref={ROUTES.achievements}
  backLabel="Back to Achievements"
  containerWidth="article"
  galleryItems={achievement.data.gallery}
  galleryTitle={achievement.data.title}
>
  <header class="achievement-header" slot="header">
    <p class="meta">
      {achievement.data.type} · {achievement.data.date}
    </p>

    <h1>{achievement.data.title}</h1>
    <p class="event">{achievement.data.event}</p>
    <p class="description">{achievement.data.description}</p>

    <div class="actions">
      {achievement.data.url && (
        <a href={achievement.data.url} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
          <Icon name="external" size={16} />
          Open Link
        </a>
      )}
      {achievement.data.game && (
        <a href={`/games/${achievement.data.game}`} class="btn">
          <Icon name="gamepad" size={16} />
          View Game
        </a>
      )}
    </div>

    {hasImage && (
      <div class="featured-image">
        <ClickableImage src={achievement.data.image} alt={achievement.data.title} client:load />
      </div>
    )}
  </header>

  <Content />
</DetailLayout>

<style>
  .achievement-header {
    margin-bottom: var(--space-11);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .meta {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--font-size-page-title);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .event {
    font-size: var(--font-size-md);
    color: var(--color-accent);
    font-weight: var(--font-weight-medium);
    margin-bottom: var(--space-6);
  }

  .description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: var(--space-8);
    max-width: 60ch;
  }

  .actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-10);
  }

  .featured-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-card);
  }

  .featured-image :global(.clickable-image) { width: 100%; }
  .featured-image :global(.clickable-image img) {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    h1 { font-size: 1.75rem; }

    .actions {
      flex-direction: column;
    }

    .actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
