---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { sortByDateDesc } from '../utils/dates';
import { publishedBooks } from '../utils/content';

const allBooks = await publishedBooks();

const reading = allBooks.filter(b => b.status === 'reading');

const finished = sortByDateDesc(
  allBooks.filter(b => b.status === 'finished'),
  b => b.data.finishDate ?? b.data.startDate
);

const wantToRead = allBooks.filter(b => b.status === 'want-to-read');
---

<Layout
  title="Books — Bartłomiej Gordon"
  description="Books I'm reading and have read, with personal notes."
>
  <div class="books-page">
    <div class="container">
      <header class="page-header">
        <h1>Books</h1>
        <p class="page-subtitle">My personal reading tracker (kept public on purpose). One of the tricks I picked up from <em>Atomic Habits</em>: making a habit visible creates accountability and keeps motivation going.</p>
        {wantToRead.length > 0 && (
          <a href="#wishlist" class="wishlist-btn">Wishlist →</a>
        )}
      </header>

      {reading.length > 0 && (
        <section class="book-group">
          <h2 class="group-title">Currently Reading</h2>
          <div class="book-list">
            {reading.map((book) => <BookCard book={book} />)}
          </div>
        </section>
      )}

      {finished.length > 0 && (
        <section class="book-group">
          <h2 class="group-title">Finished</h2>
          <div class="book-list">
            {finished.map((book) => <BookCard book={book} />)}
          </div>
        </section>
      )}

      {wantToRead.length > 0 && (
        <section id="wishlist" class="book-group">
          <h2 class="group-title">Want to Read</h2>
          <div class="book-list">
            {wantToRead.map((book) => <BookCard book={book} />)}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>

<style>
  .books-page {
    padding: 7rem 0 4rem;
    min-height: 100vh;
  }

  /* narrower than the global .container default */
  .container {
    max-width: var(--container-max-width-article);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  h1 {
    color: var(--color-text-primary);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-4);
  }

  .page-subtitle {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0 0 var(--space-6);
  }

  .wishlist-btn {
    display: inline-block;
    padding: var(--space-2) var(--space-5);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out);
  }

  .wishlist-btn:hover {
    background: var(--color-accent);
    color: var(--color-bg-primary);
  }

  .book-group {
    margin-bottom: var(--space-12);
  }

  .group-title {
    color: var(--color-text-primary);
    letter-spacing: var(--letter-spacing-tight);
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .book-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (max-width: 768px) {
    .books-page {
      padding: 6rem 0 3rem;
    }
  }
</style>
