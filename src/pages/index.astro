---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.svelte';
import JobTimeline from '../components/JobTimeline.svelte';
import ProjectsGrid from '../components/ProjectsGrid.svelte';
import AchievementCard from '../components/AchievementCard.svelte';
import Section from '../components/Section.astro';
import { publishedProjects, publishedAchievements } from '../utils/content';
import { SECTION_IDS } from '../utils/routes';
import { getThumbnail, PLACEHOLDER_IMAGE } from '../utils/projectImages';
import { getImageAsset, toOptionalPicture, toPicture, IMAGE_PRESETS } from '../utils/images';
import { professionalMonths, formatDuration } from '../utils/stats';
import type { HeroStat, ProjectSummary } from '../types';

// Load site content from JSON files
import heroData from '../content/site/hero.json';
import workExperience from '../content/site/work-experience.json';
import education from '../content/site/education.json';

// Published collections, newest-first (projects: public/ folder; achievements: non-draft)
const sortedProjects = await publishedProjects();
const sortedAchievements = await publishedAchievements();

// Images are build-time assets now, so every path is resolved here — Svelte
// islands receive ready-to-render sources and never touch the asset pipeline.
const projectItems: ProjectSummary[] = await Promise.all(
  sortedProjects.map(async (project) => ({
    slug: project.slug,
    title: project.data.title,
    description: project.data.description,
    date: project.data.date,
    tags: project.data.tags ?? [],
    teamSize: project.data.teamSize,
    thumbnail: (await toOptionalPicture(
      getThumbnail(project.slug),
      IMAGE_PRESETS.projectThumbnail,
    )) ?? { src: PLACEHOLDER_IMAGE },
  })),
);

const achievementItems = await Promise.all(
  sortedAchievements.map(async (achievement) => ({
    achievement,
    image: await toOptionalPicture(
      getImageAsset(achievement.data.image),
      IMAGE_PRESETS.achievementPhoto,
    ),
  })),
);

const heroPhoto = await toOptionalPicture(getImageAsset(heroData.photo), IMAGE_PRESETS.heroPhoto);

const withLogo = async <T extends { logo?: string }>(entry: T) => ({
  ...entry,
  logo: await toOptionalPicture(getImageAsset(entry.logo), IMAGE_PRESETS.companyLogo),
});
const workItems = await Promise.all(workExperience.map(withLogo));
const educationItems = await Promise.all(education.map(withLogo));

// Hero stats — all derived from content/dates, never hand-maintained.
const now = new Date();
const projectsCount = sortedProjects.length;
const jamPodiums = sortedAchievements.filter(
  (achievement) =>
    achievement.data.type === 'winner' || achievement.data.type === 'finalist',
).length;

const proMonths = professionalMonths(workExperience.map((job) => job.period), now);

const heroStats: HeroStat[] = [
  { label: 'Experience', value: formatDuration(proMonths) },
  { label: 'Projects', value: `${projectsCount}` },
  { label: 'Hackathons', value: `${jamPodiums} ${jamPodiums === 1 ? 'win' : 'wins'}` },
];
---

<Layout title="Bartłomiej Gordon — Unity Developer">
  {heroPhoto && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={heroPhoto.src}
      imagesrcset={heroPhoto.srcset}
      imagesizes={heroPhoto.sizes}
      fetchpriority="high"
    />
  )}

  <!-- Hero Section -->
  <Hero heroData={heroData} photo={heroPhoto} stats={heroStats} />

  <!-- Job Timeline Section -->
  <JobTimeline
    workExperience={workItems}
    education={educationItems}
  />
  
  <!-- Achievements Section -->
  <Section id={SECTION_IDS.achievements} title="Achievements">
    <div class="achievements-list">
      {achievementItems.map(({ achievement, image }) => (
        <AchievementCard achievement={achievement} image={image} />
      ))}
    </div>
  </Section>

  <!-- Projects Section -->
  <Section id={SECTION_IDS.projects} title="Projects" alt>
    <ProjectsGrid items={projectItems} />
  </Section>
</Layout>

<style>
  /* One continuous timeline spine down the centre, spanning every node.
     Drawn on the list (not per-card) so node gaps never break the line. */
  .achievements-list {
    position: relative;
  }
  .achievements-list::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    background: var(--color-border-light);
  }

  /* No centre spine once the cards stack into a single column. */
  @media (max-width: 768px) {
    .achievements-list::before {
      display: none;
    }
  }
</style>
