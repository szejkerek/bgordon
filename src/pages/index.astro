---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.svelte';
import JobTimeline from '../components/JobTimeline.svelte';
import GameCard from '../components/GameCard.svelte';
import AchievementCard from '../components/AchievementCard.svelte';
import Section from '../components/Section.astro';
import { published } from '../utils/content';
import { SECTION_IDS } from '../utils/routes';
import { getThumbnail } from '../utils/gameImages';

// Load site content from JSON files
import heroData from '../content/site/hero.json';
import workExperience from '../content/site/work-experience.json';
import education from '../content/site/education.json';

// Published (non-draft) collections, newest-first
const sortedGames = await published('games');
const sortedAchievements = await published('achievements');
---

<Layout title="Bartłomiej Gordon — Unity Developer">
  <!-- Hero Section -->
  <Hero heroData={heroData} client:load />
  
  <!-- Job Timeline Section -->
  <JobTimeline 
    workExperience={workExperience} 
    education={education} 
    client:visible 
  />
  
  <!-- Achievements Section -->
  <Section id={SECTION_IDS.achievements} title="Achievements" alt narrow>
    <div class="achievements-list">
      {sortedAchievements.map((achievement) => (
        <AchievementCard achievement={achievement} client:visible />
      ))}
    </div>
  </Section>

  <!-- Projects Section -->
  <Section id={SECTION_IDS.projects} title="Projects">
    <div class="games-grid">
      {sortedGames.map((game) => (
        <GameCard game={game} thumbnailSrc={getThumbnail(game.id)} client:visible />
      ))}
    </div>
  </Section>
</Layout>

<style>
  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: var(--space-8);
  }

  @media (max-width: 768px) {
    .games-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
