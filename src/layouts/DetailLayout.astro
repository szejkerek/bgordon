---
import Layout from './Layout.astro';
import ImageGallery from '../components/ImageGallery.svelte';

interface Props {
  title: string;
  description: string;
  image?: string;
  backHref: string;
  backLabel: string;
  containerWidth?: 'narrow' | 'article';
  galleryItems?: string[];
  galleryTitle?: string;
}

const {
  title,
  description,
  image,
  backHref,
  backLabel,
  containerWidth = 'narrow',
  galleryItems = [],
  galleryTitle = '',
} = Astro.props;
---

<Layout title={title} description={description} image={image}>
  <article class="detail-page">
    <div class={`container container--${containerWidth}`}>
      <a href={backHref} class="back-link">← {backLabel}</a>
      <slot name="header" />
      {galleryItems.length > 0 && (
        <ImageGallery
          items={galleryItems}
          title={galleryTitle}
          columns={3}
          client:load
        />
      )}
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style>
  .detail-page {
    padding: 7rem 0 4rem;
    min-height: 100vh;
  }

  @media (max-width: 768px) {
    .detail-page {
      padding: 6rem 0 3rem;
    }
  }
</style>
