---
import Media from './Media.astro';
import { formatDate } from '../utils/dates';
import { getImageAsset, toOptionalPicture, IMAGE_PRESETS } from '../utils/images';
import type { PublishedBook } from '../utils/content';

interface Props {
  book: PublishedBook;
}

const { book } = Astro.props;
const { status } = book;
const { title, author, startDate, finishDate, image, thoughts, lang } = book.data;
// Only mark what differs from the page language; tagging English as English is noise.
const foreign = lang === 'en' ? undefined : lang;
const cover = await toOptionalPicture(getImageAsset(image), IMAGE_PRESETS.bookCover);

// A book being read shows when it started; a finished one shows its span.
const dateLabel =
  status === 'reading'
    ? startDate && `Started ${formatDate(startDate)}`
    : startDate && `${formatDate(startDate)}${finishDate ? ` → ${formatDate(finishDate)}` : ''}`;
---

{status === 'want-to-read' ? (
  <article class="book-card book-card--compact">
    <h3 class="book-title" lang={foreign}>{title}</h3>
    <p class="book-author">{author}</p>
  </article>
) : (
  <article class="book-card">
    <div class="book-cover">
      <Media {...cover} alt={`Cover of ${title}`} fit="contain" fallbackIcon="book" />
    </div>

    <div class="book-info">
      {dateLabel && <span class="date">{dateLabel}</span>}
      <h3 class="book-title" lang={foreign}>{title}</h3>
      <p class="book-author">{author}</p>
      {thoughts && (
        <div class="book-thoughts">
          <p class="thoughts-text" lang={foreign}>{thoughts}</p>
          <button type="button" class="thoughts-toggle" aria-expanded="false" hidden>
            Read more
          </button>
        </div>
      )}
    </div>
  </article>
)}

<script>
  // The toggle only exists for text that actually overflows the 3-line clamp.
  // Until this runs the button stays hidden and the text unclamped, so without
  // JavaScript every review is readable in full and adds no stray tab stop.
  function setUpThoughtToggles() {
    document.querySelectorAll<HTMLElement>('.book-thoughts').forEach((block, index) => {
      const text = block.querySelector<HTMLElement>('.thoughts-text');
      const toggle = block.querySelector<HTMLButtonElement>('.thoughts-toggle');
      if (!text || !toggle) return;

      const lineHeight = parseFloat(getComputedStyle(text).lineHeight);
      const overflows = Number.isFinite(lineHeight) && text.scrollHeight > lineHeight * 3 + 4;
      if (!overflows) return;

      text.id ||= `book-thoughts-${index}`;
      toggle.setAttribute('aria-controls', text.id);
      block.classList.add('is-clampable');
      toggle.hidden = false;

      toggle.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.textContent = expanded ? 'Hide' : 'Read more';
      });
    });
  }

  if (document.fonts?.ready) {
    document.fonts.ready.then(setUpThoughtToggles);
  } else {
    setUpThoughtToggles();
  }
</script>

<style>
  .book-card {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .book-card:hover {
    border-color: var(--color-border-light);
    background: var(--color-bg-card-hover);
  }

  /* Wishlist entries have no cover and no notes — just the two lines, in the
     same card as everything else rather than a differently-decorated one. */
  .book-card--compact {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-7);
    height: 100%;
  }

  .book-card--compact .book-title {
    font-size: var(--font-size-lg);
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .book-card--compact .book-author {
    white-space: normal;
    overflow: visible;
    font-size: var(--font-size-sm);
  }

  .book-cover {
    flex-shrink: 0;
    width: 206px;
    height: 275px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .book-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: center;
  }

  .date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-title {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-author {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-thoughts {
    margin: var(--space-2) 0 0;
  }

  .thoughts-text {
    margin: 0;
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .book-thoughts.is-clampable:not(.is-open) .thoughts-text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .thoughts-toggle {
    margin-top: var(--space-2);
    padding: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .thoughts-toggle:hover {
    color: var(--color-accent-dim);
  }

  @media (max-width: 600px) {
    .book-card {
      flex-direction: column;
      gap: var(--space-6);
    }

    .book-cover {
      width: 163px;
      height: 216px;
    }
  }
</style>
