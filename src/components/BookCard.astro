---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.svelte';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { title, author, status, startDate, finishDate, image, thoughts } = book.data;
---

{status === 'want-to-read' ? (
  <article class="book-card book-card--wishlist">
    <h3 class="book-title">{title}</h3>
    <p class="book-author">{author}</p>
  </article>
) : (
  <article class={`book-card${status === 'reading' ? ' book-card--reading' : ''}`}>
    <div class="book-cover">
      <Media src={image} alt={`Cover of ${title}`} fit="cover" fallbackIcon="book" client:visible />
    </div>

    <div class="book-info">
      {startDate && (
        <span class="date">
          {startDate}{finishDate ? ` → ${finishDate}` : ''}
        </span>
      )}
      <h3 class="book-title">{title}</h3>
      <p class="book-author">{author}</p>
      {thoughts && (
        <details class="book-thoughts">
          <summary>
            <span class="thoughts-text">{thoughts}</span>
          </summary>
        </details>
      )}
    </div>
  </article>
)}

<style>
  .book-card {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .book-card:hover {
    border-color: var(--color-border-light);
    background: var(--color-bg-card-hover);
  }

  .book-card--reading {
    padding: var(--space-10);
    background: var(--color-bg-elevated);
    border-color: var(--color-accent);
  }

  .book-card--reading:hover {
    background: var(--color-bg-elevated);
    border-color: var(--color-accent);
  }

  .book-card--wishlist {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    flex-wrap: nowrap;
  }

  .book-cover {
    flex-shrink: 0;
    width: 120px;
    height: 160px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .book-card--reading .book-cover {
    width: 140px;
    height: 185px;
  }

  .book-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    justify-content: center;
  }

  .date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-title {
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-card--reading .book-title {
    font-size: var(--font-size-xl);
  }

  .book-author {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-thoughts {
    margin: var(--space-2) 0 0;
  }

  .book-thoughts summary {
    list-style: none;
    cursor: pointer;
  }

  .book-thoughts summary::-webkit-details-marker {
    display: none;
  }

  .thoughts-text {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .book-thoughts:not([open]) .thoughts-text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-thoughts summary::after {
    content: 'Read more';
    display: inline-block;
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .book-thoughts[open] summary::after {
    content: 'Hide';
  }

  .book-thoughts summary:hover::after {
    color: var(--color-accent-dim);
  }

  @media (max-width: 600px) {
    .book-card {
      flex-direction: column;
      gap: var(--space-6);
    }

    .book-cover {
      width: 90px;
      height: 120px;
    }

    .book-card--reading .book-cover {
      width: 100px;
      height: 135px;
    }

    .book-card--wishlist {
      flex-wrap: wrap;
    }
  }
</style>
