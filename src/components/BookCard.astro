---
import Media from './Media.astro';
import { formatDate } from '../utils/dates';
import { getImageAsset, toOptionalPicture, IMAGE_PRESETS } from '../utils/images';
import type { PublishedBook } from '../utils/content';

interface Props {
  book: PublishedBook;
}

const { book } = Astro.props;
const { status } = book;
const { title, author, startDate, finishDate, image, thoughts, lang } = book.data;
// Only mark what differs from the page language; tagging English as English is noise.
const foreign = lang === 'en' ? undefined : lang;
const cover = await toOptionalPicture(getImageAsset(image), IMAGE_PRESETS.bookCover);
---

{status === 'want-to-read' ? (
  <article class="book-card book-card--wishlist">
    <h3 class="book-title" lang={foreign}>{title}</h3>
    <p class="book-author">{author}</p>
  </article>
) : status === 'reading' ? (
  <article class="reading-card">
    <div class="reading-cover">
      <Media {...cover} alt={`Cover of ${title}`} fit="contain" fallbackIcon="book" />
    </div>

    <div class="reading-info">
      <p class="reading-eyebrow"><span class="reading-pulse" aria-hidden="true"></span>Now Reading</p>
      <h3 class="reading-title" lang={foreign}>{title}</h3>
      <p class="reading-author">by {author}</p>
      {startDate && (
        <span class="reading-date">Started {formatDate(startDate)}</span>
      )}
      {thoughts && (
        <div class="book-thoughts">
          <p class="thoughts-text" lang={foreign}>{thoughts}</p>
          <button type="button" class="thoughts-toggle" aria-expanded="false" hidden>
            Read more
          </button>
        </div>
      )}
    </div>
  </article>
) : (
  <article class="book-card">
    <div class="book-cover">
      <Media {...cover} alt={`Cover of ${title}`} fit="contain" fallbackIcon="book" />
    </div>

    <div class="book-info">
      {startDate && (
        <span class="date">
          {formatDate(startDate)}{finishDate ? ` → ${formatDate(finishDate)}` : ''}
        </span>
      )}
      <h3 class="book-title" lang={foreign}>{title}</h3>
      <p class="book-author">{author}</p>
      {thoughts && (
        <div class="book-thoughts">
          <p class="thoughts-text" lang={foreign}>{thoughts}</p>
          <button type="button" class="thoughts-toggle" aria-expanded="false" hidden>
            Read more
          </button>
        </div>
      )}
    </div>
  </article>
)}

<script>
  // The toggle only exists for text that actually overflows the 3-line clamp.
  // Until this runs the button stays hidden and the text unclamped, so without
  // JavaScript every review is readable in full and adds no stray tab stop.
  function setUpThoughtToggles() {
    document.querySelectorAll<HTMLElement>('.book-thoughts').forEach((block, index) => {
      const text = block.querySelector<HTMLElement>('.thoughts-text');
      const toggle = block.querySelector<HTMLButtonElement>('.thoughts-toggle');
      if (!text || !toggle) return;

      const lineHeight = parseFloat(getComputedStyle(text).lineHeight);
      const overflows = Number.isFinite(lineHeight) && text.scrollHeight > lineHeight * 3 + 4;
      if (!overflows) return;

      text.id ||= `book-thoughts-${index}`;
      toggle.setAttribute('aria-controls', text.id);
      block.classList.add('is-clampable');
      toggle.hidden = false;

      toggle.addEventListener('click', () => {
        const expanded = block.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.textContent = expanded ? 'Hide' : 'Read more';
      });
    });
  }

  if (document.fonts?.ready) {
    document.fonts.ready.then(setUpThoughtToggles);
  } else {
    setUpThoughtToggles();
  }
</script>

<style>
  .book-card {
    display: flex;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .book-card:hover {
    border-color: var(--color-border-light);
    background: var(--color-bg-card-hover);
  }

  /* Currently reading: featured card, distinct from the finished list. */
  .reading-card {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: var(--space-10);
    padding: var(--space-10);
    max-width: 740px;
    margin: 0 auto;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
  }

  /* Soft accent glow bleeding in from the top-right corner. */
  .reading-card::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -20%;
    width: 60%;
    height: 160%;
    background: radial-gradient(
      ellipse at center,
      var(--color-accent-glow) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .reading-cover {
    position: relative;
    flex-shrink: 0;
    width: 195px;
    height: 293px;
  }

  /* Offset accent frame echoing the hero photo. */
  .reading-cover::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translate(7px, 7px);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-md);
    opacity: 0.3;
    pointer-events: none;
  }

  .reading-cover :global(img),
  .reading-cover :global(.media) {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-card);
  }

  .reading-info {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-4);
  }

  .reading-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .reading-pulse {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    box-shadow: 0 0 0 0 var(--color-accent-glow);
    animation: reading-pulse 2s var(--ease-out) infinite;
  }

  @keyframes reading-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(125, 186, 149, 0.5);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(125, 186, 149, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(125, 186, 149, 0);
    }
  }

  .reading-title {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0;
  }

  .reading-author {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .reading-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-card--wishlist {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6);
    height: 100%;
    border-left: 3px solid var(--color-accent);
  }

  .book-card--wishlist .book-title {
    font-size: var(--font-size-lg);
    -webkit-line-clamp: 3;
  }

  .book-card--wishlist .book-author {
    white-space: normal;
    overflow: visible;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-cover {
    flex-shrink: 0;
    width: 165px;
    height: 220px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-bg-elevated);
  }

  .book-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: center;
  }

  .date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .book-title {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-tight);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-author {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .book-thoughts {
    margin: var(--space-2) 0 0;
  }

  .thoughts-text {
    margin: 0;
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .book-thoughts.is-clampable:not(.is-open) .thoughts-text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .thoughts-toggle {
    margin-top: var(--space-2);
    padding: 0;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .thoughts-toggle:hover {
    color: var(--color-accent-dim);
  }

  @media (max-width: 600px) {
    .book-card,
    .reading-card {
      flex-direction: column;
      gap: var(--space-6);
    }

    .book-cover {
      width: 130px;
      height: 173px;
    }

    .reading-cover {
      width: 160px;
      height: 240px;
    }

    .reading-title {
      font-size: var(--font-size-2xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-pulse {
      animation: none;
    }
  }
</style>
